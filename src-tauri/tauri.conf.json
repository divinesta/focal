{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focal",
  "version": "0.1.0",
  "identifier": "app.focal.timer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Focal",
        "width": 340,
        "height": 470,
        "minWidth": 120,
        "minHeight": 120,
        "decorations": false,
        "visible": false,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Always-on-top focus timer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
